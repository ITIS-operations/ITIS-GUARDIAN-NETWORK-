# ITIS Dedicated GPS Telemetry Server Configuration
# Copy to .env for deployment configuration
# NOTE: DO NOT commit actual secrets or production keys

# Network Binding
HOST=0.0.0.0
TCP_PORT=5023
UDP_PORT=5024
HEALTH_PORT=8092

# Runtime & Environment
NODE_ENV=production
LOG_LEVEL=info

# Connection & Security Limits
MAX_CONNECTIONS=500
MAX_PACKET_SIZE_BYTES=2048
RATE_LIMIT_PACKETS_PER_SEC=10
CONNECTION_TIMEOUT_MS=60000
IDLE_TIMEOUT_MS=180000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000

# Authoritative Backend Integration Mode
# Options: 'IN_PROCESS' (direct TelemetryGatewayEngine bridge) or 'REMOTE_HTTP'
INTEGRATION_MODE=IN_PROCESS

# Remote Backend Configuration (Required only if INTEGRATION_MODE=REMOTE_HTTP)
# ITIS_API_URL=https://itis-backend.example.com
# ITIS_SERVICE_KEY=
