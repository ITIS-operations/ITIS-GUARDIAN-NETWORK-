# ==============================================================================
# ITIS GPS TELEMETRY SERVER — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# NOTE: This file contains placeholders only. Do not commit actual secrets or credentials.

# ------------------------------------------------------------------------------
# 1. Server Environment & Runtime Ports
# ------------------------------------------------------------------------------
NODE_ENV=
PORT=
HOST=
TCP_PORT=
UDP_PORT=

# ------------------------------------------------------------------------------
# 2. Storage Mode & Database Configuration
# ------------------------------------------------------------------------------
# Set TELEMETRY_STORAGE_MODE to 'memory' for local testing or 'postgresql' for production.
TELEMETRY_STORAGE_MODE=

# PostgreSQL Database Connection String (Direct URI)
DATABASE_URL=

# Individual PostgreSQL Connection Parameters (Alternative to DATABASE_URL)
TELEMETRY_DB_HOST=
TELEMETRY_DB_PORT=
TELEMETRY_DB_NAME=
TELEMETRY_DB_USER=
TELEMETRY_DB_PASSWORD=
TELEMETRY_DB_SSL=
TELEMETRY_DB_POOL_MAX=

# ------------------------------------------------------------------------------
# 3. Security Limits & Connection Guard
# ------------------------------------------------------------------------------
DEVICE_CONNECTION_LIMIT=
MAX_CONCURRENT_TCP_CONNECTIONS=
MAX_PACKET_SIZE_BYTES=
DEVICE_IDLE_TIMEOUT_SECONDS=
RATE_LIMIT_MAX_PACKETS_PER_MINUTE=

# ------------------------------------------------------------------------------
# 4. Upstream ITIS Guardian Network Integration
# ------------------------------------------------------------------------------
ITIS_CORE_API_URL=
ITIS_TELEMETRY_API_KEY=
ITIS_EVENT_DISPATCH_ENABLED=

# ------------------------------------------------------------------------------
# 5. Local Hardware Simulation (Development Only)
# ------------------------------------------------------------------------------
ENABLE_DEV_SIMULATOR=
SIMULATOR_DEVICE_COUNT=
SIMULATOR_INTERVAL_MS=
