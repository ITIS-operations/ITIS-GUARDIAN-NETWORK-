# Environment Configuration
NODE_ENV=development

# Production PostgreSQL Database Connection
# Option 1: Standard Connection String (Vercel Postgres, Neon, Cloud SQL with SSL, Supabase)
DATABASE_URL=
POSTGRES_URL=

# Option 2: Discrete Cloud SQL / PostgreSQL Parameters
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=cloud_sql_development_database
PGSSLMODE=require

