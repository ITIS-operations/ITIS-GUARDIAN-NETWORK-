# ==============================================================================
# ITIS GUARDIAN NETWORK — POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
NODE_ENV=development

# ------------------------------------------------------------------------------
# OPTION A: Connection URI / Connection String
# Supports Neon, Supabase, Cloud SQL TCP, Vercel Postgres, Render, AWS RDS
# ------------------------------------------------------------------------------
DATABASE_URL=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRESQL_URL=

# ------------------------------------------------------------------------------
# OPTION B: Discrete Connection Parameters
# Supports Cloud SQL Unix Sockets (/cloudsql/PROJECT:REGION:INSTANCE) or direct TCP
# ------------------------------------------------------------------------------
SQL_HOST=
SQL_PORT=5432
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=cloud_sql_development_database

# ------------------------------------------------------------------------------
# SSL & Connection Security Options
# Values: require | disable | prefer (Defaults to require for non-local TCP connections)
# ------------------------------------------------------------------------------
PGSSL_MODE=require
PGSSLMODE=require
DISABLE_SSL=false

# ------------------------------------------------------------------------------
# Security & Enrolment Credentials
# ------------------------------------------------------------------------------
GUARDIAN_INITIAL_PASSWORD=

# ------------------------------------------------------------------------------
# Dedicated Telemetry Server to Authoritative Core Service Authentication
# ------------------------------------------------------------------------------
ITIS_TELEMETRY_SERVICE_ID=itis-telemetry-server-01
ITIS_TELEMETRY_SERVICE_KEY=
ITIS_TELEMETRY_SERVICE_SECRET=
MAX_RETRY_QUEUE_SIZE=500
RETRY_BACKOFF_MS=500
MAX_RETRY_ATTEMPTS=10


