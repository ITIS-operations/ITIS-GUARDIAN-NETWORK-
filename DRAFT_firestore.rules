rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Default-Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitives & Hardened Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 3. Test Connectivity Endpoint (Client Health Check)
    match /test/{docId} {
      allow read: if true;
    }

    // 4. Users Collection (Read-only for owner/admin; writes mastered exclusively via PostgreSQL API)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow write: if false;
    }

    // 5. Schools Collection (Read-only metadata for signed-in users)
    match /schools/{schoolId} {
      allow get: if isSignedIn() && isValidId(schoolId);
      allow list: if isSignedIn();
      allow write: if false;
    }

    // 6. Learners Collection (Mastered & secured authoritatively via ITIS PostgreSQL ABAC API)
    match /learners/{learnerId} {
      allow read, write: if false;
    }

    // 7. Incidents Collection (Mastered & secured authoritatively via ITIS PostgreSQL ABAC API)
    match /incidents/{incidentId} {
      allow read, write: if false;
    }

    // 8. Audit Events (Chained & mastered exclusively in PostgreSQL)
    match /audit_events/{eventId} {
      allow read, write: if false;
    }

    // 9. Admins Collection (Managed exclusively server-side)
    match /admins/{adminId} {
      allow read, write: if false;
    }
  }
}
